<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>FarsiLibrary.Win.DevExpress</RootNamespace>
		<OutputPath>..\binaries\</OutputPath>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>

		<PackageId>PersianDatetimePicker</PackageId>
		<Version>3.5.0</Version>
		<Authors>YourNameOrCompany</Authors>
		<Company>FarsiLibrary</Company>
		<Description>A Persian DateTime Picker for DevExpress Windows Forms.</Description>

	</PropertyGroup>

	<PropertyGroup>
		<SignAssembly>true</SignAssembly>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyOriginatorKeyFile>..\FarsiLibrary.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Solution Items\CommonAssemblyInfo.cs">
			<Link>Properties\CommonAssemblyInfo.cs</Link>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DevExpress.Win.Design" Version="25.2.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FarsiLibrary.Localization\FarsiLibrary.Localization.csproj" />
		<ProjectReference Include="..\FarsiLibrary.Utils\FarsiLibrary.Utils.csproj" />
		<ProjectReference Include="..\FarsiLibrary.Win\FarsiLibrary.Win.csproj" />
	</ItemGroup>
</Project>